{
  "name": "plancia-comandi",
  "productName": "Plancia Comandi",
  "private": true,
  "version": "0.3.17",
  "description": "Desktop terminal manager for Codex CLI and other shells",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:site": "vite preview --config vite.site.config.ts --outDir docs",
    "check:site": "node scripts/check-site.mjs",
    "dist": "vite build && electron-builder",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:win": "vite build && electron-builder --win --x64",
    "dist:linux": "vite build && electron-builder --linux",
    "test": "vitest run",
    "test:watch": "vitest",
    "rebuild": "electron-builder install-app-deps",
    "postinstall": "node scripts/install-native.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/headless": "5.5.0",
    "@xterm/xterm": "5.5.0",
    "node-pty": "1.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/fuses": "2.1.3",
    "@types/node": "22.19.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vite-plugin-electron": "0.29.1",
    "vite-plugin-electron-renderer": "0.14.6",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  }
}
