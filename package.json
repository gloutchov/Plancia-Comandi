{
  "name": "plancia-comandi",
  "productName": "Plancia Comandi",
  "private": true,
  "version": "0.2.0",
  "description": "Desktop terminal manager for Codex CLI and other shells",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "dist": "vite build && electron-builder",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:win": "vite build && electron-builder --win --x64",
    "dist:linux": "vite build && electron-builder --linux",
    "test": "vitest run",
    "test:watch": "vitest",
    "rebuild": "electron-builder install-app-deps",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/headless": "5.5.0",
    "@xterm/xterm": "5.5.0",
    "node-pty": "1.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vite-plugin-electron": "0.29.1",
    "vite-plugin-electron-renderer": "0.14.6",
    "vitest": "3.2.4"
  }
}
