{
  "_comment": "Plancia Comandi central configuration. No secrets. Invalid values fall back to the documented defaults. Restart the app after editing.",
  "clipboardImages": {
    "directoryName": "clipboard-images",
    "filePrefix": "img",
    "maxBytes": 12582912,
    "maxEdgePx": 8000,
    "maxKeep": 40,
    "maxAgeHours": 24
  },
  "terminal": {
    "maxWriteChars": 200000
  },
  "drop": {
    "maxFiles": 20,
    "maxPathChars": 4096
  },
  "settings": {
    "maxBytes": 262144
  },
  "diagnostics": {
    "maxBytes": 65536
  },
  "childPolling": {
    "intervalMs": 2500,
    "initialBackoffMs": 10000,
    "maxBackoffMs": 60000,
    "unavailableAfter": 3
  },
  "statusPatterns": {
    "budgetMs": 50,
    "startupTimeoutMs": 2000,
    "maxInputChars": 4096,
    "workerMemoryMb": 32
  },
  "sessions": {
    "maxSessions": 12,
    "maxBacklogChars": 300000,
    "retainedBacklogChars": 250000,
    "statusIntervalMs": 400
  },
  "processSnapshot": {
    "unixTimeoutMs": 4000,
    "windowsTimeoutMs": 8000
  }
}
