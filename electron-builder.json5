{
  $schema: "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  appId: "it.plancia.comandi",
  productName: "Plancia Comandi",
  executableName: "Plancia Comandi",
  // electron-builder 26.18.0's electronFuses key cannot declare the ninth fuse
  // or strictlyRequireAllFuses. scripts/after-pack-fuses.mjs is the flip.
  afterPack: "scripts/after-pack-fuses.mjs",
  asar: true,
  // The whole node-pty tree is unpacked, including prebuilds/win32-x64/conpty/conpty.dll and OpenConsole.exe.
  asarUnpack: [
    "**/node_modules/node-pty/**/*",
    "**/node_modules/node-pty/prebuilds/win32-x64/conpty/conpty.dll",
    "**/node_modules/node-pty/prebuilds/win32-x64/conpty/OpenConsole.exe",
    "**/node_modules/@xterm/headless/**/*",
  ],
  // Windows uses the N-API prebuilds in node-pty. Rebuilding here would call
  // node-gyp. install-native.mjs probes macOS prebuilds in Electron and prepares
  // spawn-helper; incompatible/missing macOS prebuilds and Linux still rebuild.
  npmRebuild: false,
  directories: {
    output: "release",
  },
  files: ["dist/**/*", "dist-electron/**/*", "package.json", "node_modules/**/*", "config/**/*", "build/icon.png", "build/icon.ico"],
  extraResources: [{ from: "config", to: "config" }],
  mac: {
    category: "public.app-category.developer-tools",
    target: ["dmg", "zip"],
    identity: null,
    icon: "build/icon.icns",
    artifactName: "PlanciaComandi-mac-${version}-${arch}.${ext}",
  },
  win: {
    appId: "it.plancia.comandi.Desktop",
    icon: "build/icon.ico",
    // Explorer cannot resolve a taskbar RelaunchIconResource inside app.asar.
    extraResources: [{ from: "build/icon.ico", to: "icon.ico" }],
    target: [
      { target: "nsis", arch: ["x64"] },
      { target: "portable", arch: ["x64"] },
    ],
    artifactName: "PlanciaComandi-win-${version}-${arch}.${ext}",
  },
  nsis: {
    // Preserve the installation and uninstall registration across the AppUserModelID change.
    guid: "0afcd0a3-78db-51ba-9797-e42794a20e00",
    oneClick: false,
    perMachine: false,
    allowToChangeInstallationDirectory: true,
    deleteAppDataOnUninstall: false,
  },
  linux: {
    executableName: "plancia-comandi",
    category: "Development",
    target: ["AppImage", "deb"],
    icon: "build/icon.png",
    artifactName: "PlanciaComandi-linux-${version}-${arch}.${ext}",
  },
}
